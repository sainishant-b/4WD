extends Node
## Autoload "UiFeel": the small touches every screen shares, wired here once so
## no screen has to:
##   - every button presses in a little and springs back, and clicks,
##   - `intro(screen)` fades a freshly opened screen's buttons in one after
##     another, top to bottom (Transition calls it as the curtain opens),
##   - `sound(name)` plays an interface sound: "click", "whoosh", "pop", "best"
##     (generated by tools/generate_sfx.py),
##   - `buzz(ms)` gives a short vibration on a phone (Android, and phone
##     browsers that allow it; iPhones ignore it). Nothing on a desktop.
## Kept small and quick on purpose (the user: "minimal in taste and smooth").

const PRESS_SCALE := 0.95
const PRESS_TIME := 0.06
const RELEASE_TIME := 0.22
const INTRO_STEP := 0.035   # s between one button fading in and the next
const INTRO_MAX_STEPS := 10 # later buttons all start by then
const INTRO_TIME := 0.24
const SOUNDS := {
	"click": ["res://audio/ui_click.wav", -6.0],
	"whoosh": ["res://audio/ui_whoosh.wav", -10.0],
	"pop": ["res://audio/ui_pop.wav", -4.0],
	"best": ["res://audio/best.wav", -3.0],
}

var _players: Dictionary = {}


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for name: String in SOUNDS:
		var player := AudioStreamPlayer.new()
		player.stream = load(SOUNDS[name][0])
		player.volume_db = SOUNDS[name][1]
		add_child(player)
		_players[name] = player
	get_tree().node_added.connect(_on_node_added)


func _on_node_added(node: Node) -> void:
	if not (node is BaseButton) or node.has_meta(&"ui_feel"):
		return
	var button: BaseButton = node
	button.set_meta(&"ui_feel", true)
	button.button_down.connect(_press.bind(button, true))
	button.button_up.connect(_press.bind(button, false))
	button.pressed.connect(sound.bind("click"))


## Presses `button` in (down) or springs it back out, about its centre.
func _press(button: BaseButton, down: bool) -> void:
	if not is_instance_valid(button):
		return
	var old: Variant = button.get_meta(&"ui_press", null)
	if old is Tween and (old as Tween).is_valid():
		(old as Tween).kill()
	button.pivot_offset = button.size * 0.5
	var tw := button.create_tween()
	if down:
		tw.tween_property(button, "scale", Vector2.ONE * PRESS_SCALE, PRESS_TIME) \
			.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	else:
		tw.tween_property(button, "scale", Vector2.ONE, RELEASE_TIME) \
			.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	button.set_meta(&"ui_press", tw)


## A screen just opened: its visible buttons fade in one after another, top to
## bottom, left to right. Only menu screens (a Control at the root); the race
## builds its own HUD.
func intro(screen: Node) -> void:
	if not (screen is Control):
		return
	var buttons: Array = screen.find_children("*", "BaseButton", true, false).filter(
		func(b: BaseButton) -> bool: return b.is_visible_in_tree())
	buttons.sort_custom(func(a: BaseButton, b: BaseButton) -> bool:
		var ay := a.global_position.y
		var by := b.global_position.y
		return ay < by if absf(ay - by) > 8.0 else a.global_position.x < b.global_position.x)
	for i in buttons.size():
		var button: BaseButton = buttons[i]
		var alpha := button.modulate.a
		button.modulate.a = 0.0
		var tw := button.create_tween()
		tw.tween_interval(mini(i, INTRO_MAX_STEPS) * INTRO_STEP)
		tw.tween_property(button, "modulate:a", alpha, INTRO_TIME).set_ease(Tween.EASE_OUT)


func sound(name: String) -> void:
	var player: AudioStreamPlayer = _players.get(name)
	if player != null and player.stream != null:
		player.play()


## A short vibration on a phone (`ms` long). Off unless the touch controls are.
func buzz(ms: int) -> void:
	if Layout.touch:
		Input.vibrate_handheld(ms)
