[resource]
; ===== global =====
default_font = ExtResource("font_display")
default_font_size = 16

; ===== Button (primary / gold) =====
Button/colors/font_color = Color(0.0431373, 0.0823529, 0.262745, 1)
Button/colors/font_hover_color = Color(0.0431373, 0.0823529, 0.262745, 1)
Button/colors/font_pressed_color = Color(0.0431373, 0.0823529, 0.262745, 1)
Button/colors/font_hover_pressed_color = Color(0.0431373, 0.0823529, 0.262745, 1)
Button/colors/font_disabled_color = Color(0.572549, 0.568627, 0.607843, 1)
Button/colors/font_focus_color = Color(0.0431373, 0.0823529, 0.262745, 1)
Button/font_sizes/font_size = 15
Button/styles/normal = SubResource("btn_normal")
Button/styles/hover = SubResource("btn_hover")
Button/styles/pressed = SubResource("btn_pressed")
Button/styles/hover_pressed = SubResource("btn_pressed")
Button/styles/disabled = SubResource("btn_disabled")
Button/styles/focus = SubResource("btn_focus")

; ===== ButtonSecondary (pop red-orange) — theme_type_variation = "ButtonSecondary" =====
ButtonSecondary/base_type = &"Button"
ButtonSecondary/colors/font_color = Color(1, 1, 1, 1)
ButtonSecondary/colors/font_hover_color = Color(1, 1, 1, 1)
ButtonSecondary/colors/font_pressed_color = Color(1, 1, 1, 1)
ButtonSecondary/colors/font_hover_pressed_color = Color(1, 1, 1, 1)
ButtonSecondary/colors/font_focus_color = Color(1, 1, 1, 1)
ButtonSecondary/styles/normal = SubResource("btn2_normal")
ButtonSecondary/styles/hover = SubResource("btn2_hover")
ButtonSecondary/styles/pressed = SubResource("btn2_pressed")
ButtonSecondary/styles/hover_pressed = SubResource("btn2_pressed")

; ===== ButtonDanger (red) =====
ButtonDanger/base_type = &"Button"
ButtonDanger/colors/font_color = Color(1, 1, 1, 1)
ButtonDanger/colors/font_hover_color = Color(1, 1, 1, 1)
ButtonDanger/colors/font_pressed_color = Color(1, 1, 1, 1)
ButtonDanger/colors/font_hover_pressed_color = Color(1, 1, 1, 1)
ButtonDanger/colors/font_focus_color = Color(1, 1, 1, 1)
ButtonDanger/styles/normal = SubResource("btnd_normal")
ButtonDanger/styles/hover = SubResource("btnd_hover")
ButtonDanger/styles/pressed = SubResource("btnd_pressed")
ButtonDanger/styles/hover_pressed = SubResource("btnd_pressed")

; ===== ButtonGhost (cream) =====
ButtonGhost/base_type = &"Button"
ButtonGhost/colors/font_color = Color(0.0470588, 0.0941176, 0.298039, 1)
ButtonGhost/colors/font_hover_color = Color(0.0470588, 0.0941176, 0.298039, 1)
ButtonGhost/colors/font_pressed_color = Color(0.0470588, 0.0941176, 0.298039, 1)
ButtonGhost/colors/font_hover_pressed_color = Color(0.0470588, 0.0941176, 0.298039, 1)
ButtonGhost/colors/font_focus_color = Color(0.0470588, 0.0941176, 0.298039, 1)
ButtonGhost/styles/normal = SubResource("btng_normal")
ButtonGhost/styles/hover = SubResource("btng_hover")
ButtonGhost/styles/pressed = SubResource("btng_pressed")
ButtonGhost/styles/hover_pressed = SubResource("btng_pressed")

; ===== Panel / PanelContainer =====
Panel/styles/panel = SubResource("panel_card")
PanelContainer/styles/panel = SubResource("panel_card")

; ===== PanelModal — theme_type_variation = "PanelModal" =====
PanelModal/base_type = &"PanelContainer"
PanelModal/styles/panel = SubResource("panel_modal")

; ===== PanelStripe — thicker top band =====
PanelStripe/base_type = &"PanelContainer"
PanelStripe/styles/panel = SubResource("panel_stripe")

; ===== PanelInset — recessed well =====
PanelInset/base_type = &"PanelContainer"
PanelInset/styles/panel = SubResource("panel_inset")

; ===== HSlider (volume) =====
HSlider/styles/slider = SubResource("slider_track")
HSlider/styles/grabber_area = SubResource("slider_fill")
HSlider/styles/grabber_area_highlight = SubResource("slider_fill")

; ===== LineEdit (leaderboard name) =====
LineEdit/colors/font_color = Color(0.0470588, 0.0941176, 0.298039, 1)
LineEdit/colors/font_placeholder_color = Color(0.341176, 0.352941, 0.454902, 1)
LineEdit/colors/caret_color = Color(0.0470588, 0.0941176, 0.298039, 1)
LineEdit/colors/selection_color = Color(1, 0.768627, 0, 0.5)
LineEdit/styles/normal = SubResource("edit_normal")
LineEdit/styles/focus = SubResource("edit_focus")

; ===== Labels / text colors (dark ink: most text sits on a cream card) =====
Label/colors/font_color = Color(0.0470588, 0.0941176, 0.298039, 1)
Label/font_sizes/font_size = 16

; ===== LabelBody (Barlow body copy) — theme_type_variation = "LabelBody" =====
LabelBody/base_type = &"Label"
LabelBody/colors/font_color = Color(0.0470588, 0.0941176, 0.298039, 1)
LabelBody/fonts/font = SubResource("font_body_bold")
