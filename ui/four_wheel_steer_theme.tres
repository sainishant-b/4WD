[gd_resource type="Theme" load_steps=26 format=3]

; ============================================================
; FOUR WHEEL STEER — Godot 4 Theme · "Cobalt & Sun"
; Colors are the Palette.gd tokens as Godot float Color(r,g,b,a).
; Every raised thing (buttons, cards) has a 3 px INK outline and a
; hard INK lip under it: the bottom border is thicker and drawn
; below the control's rect (expand_margin_bottom), with a soft navy
; shadow under that. Pressed buttons lose most of the lip and their
; label drops, so they read as pushed in.
; Fonts: Chakra Petch (Bold) is the default display/UI/HUD face;
; Barlow (Regular) is the body face via the "LabelBody" variation
; (theme_type_variation = "LabelBody"). Both live in ui/fonts/.
; ============================================================

[ext_resource type="FontFile" uid="uid://c55f66531u5gt" path="res://ui/fonts/ChakraPetch-Bold.ttf" id="font_display"]
[ext_resource type="FontFile" uid="uid://dqcqug38qohtn" path="res://ui/fonts/Barlow-Regular.ttf" id="font_body"]

; ---------- BODY FACE · Barlow, thickened ----------
; Only Barlow Regular is bundled; at body sizes it reads thin, so the
; LabelBody variation uses this emboldened copy.
[sub_resource type="FontVariation" id="font_body_bold"]
base_font = ExtResource("font_body")
variation_embolden = 0.8

; ---------- BUTTON · primary (sun gold) ----------
[sub_resource type="StyleBoxFlat" id="btn_normal"]
bg_color = Color(1, 0.768627, 0, 1)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 8
